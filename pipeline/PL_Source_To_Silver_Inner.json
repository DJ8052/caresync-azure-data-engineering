{
	"name": "PL_Source_To_Silver_Inner",
	"properties": {
		"activities": [
			{
				"name": "Read_Table_Details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.table_config WHERE table_id = @{pipeline().parameters.table_id};",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set_Start_Time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Start_Time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_HH-mm-ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Source_To_Landing_Ingestion",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Check_Load_Type",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "\n@concat(\n    'SELECT * FROM public.',\n    activity('Read_Table_Details').output.firstRow.source_table_name,\n    if(\n        equals(activity('Read_Table_Details').output.firstRow.load_type, 'FULL'),\n        '',\n        concat(\n            ' WHERE ',\n            activity('Read_Table_Details').output.firstRow.watermark_column,\n            ' > ''',\n            variables('Watermark_Variable'),\n            ''''\n        )\n    )\n)\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_PostgreSqlTable1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Parquet1",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": {
								"value": "@concat(\n    activity('Read_Table_Details').output.firstRow.source_system,\n    '/',\n    activity('Read_Table_Details').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Landing_To_Bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Source_To_Landing_Ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/djjohnson@compliance314.onmicrosoft.com/caresync-azure-data-engineering/Landing_To_Bronze",
					"baseParameters": {
						"source_system": {
							"value": "@activity('Read_Table_Details').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read_Table_Details').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('Start_Time')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_Databricks_CareSync",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Bronze_To_Sillver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Landing_To_Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/djjohnson@compliance314.onmicrosoft.com/caresync-azure-data-engineering/Bronze_To_Silver",
					"baseParameters": {
						"table_name": {
							"value": "@activity('Read_Table_Details').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('Start_Time')",
							"type": "Expression"
						},
						"merge_keys": {
							"value": "@coalesce(activity('Read_Table_Details').output.firstRow.merge_keys, '')",
							"type": "Expression"
						},
						"load_type": {
							"value": "@activity('Read_Table_Details').output.firstRow.load_type",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_Databricks_CareSync",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update_Success_Status",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Bronze_To_Sillver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_CareSync",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE ctrl.audit_log\nSET STATUS = 'SUCCESS', END_TIME = SYSUTCDATETIME(), records_written = @{activity('Bronze_To_Sillver').output.runOutput}\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}' AND table_id = @{pipeline().parameters.table_id};",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Check_Load_Type",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Read_Table_Details",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_Start_Time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read_Table_Details').output.firstRow.load_type,'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Read_Watermark",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT watermark_value FROM ctrl.watermark WHERE table_id =@{pipeline().parameters.table_id};",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "AzureSqlTable1",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Store_Watermark_Value",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Read_Watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "Watermark_Variable",
								"value": {
									"value": "@activity('Read_Watermark').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Check_Load_Type_And_Update_Watermark",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Bronze_To_Sillver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read_Table_Details').output.firstRow.load_type,'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Update_Watermark",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL_CareSync",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE ctrl.watermark\nSET watermark_value= SYSUTCDATETIME()\nWHERE table_id = @{pipeline().parameters.table_id};",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			},
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"Start_Time": {
				"type": "String"
			},
			"Watermark_Variable": {
				"type": "String"
			}
		},
		"annotations": []
	}
}