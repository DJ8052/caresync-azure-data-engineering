{
	"name": "PL_Send_Email",
	"properties": {
		"activities": [
			{
				"name": "Read_All_Tables_Status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.audit_log WHERE adf_run_id = '@{pipeline().parameters.adf_run_id}';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare_Email_Body_Header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "The ingestion and transformation process for the Caresync project has been completed and the status is below."
				}
			},
			{
				"name": "Prepare_Email_Body_Footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "<p>For any support, please reach out to:<br>\nDJJohnson@Compliance314.onmicrosoft.com</p>\n\n<p>Regards,<br>\n<strong>Clarity Before Dashboards™</strong></p>"
				}
			},
			{
				"name": "Prepare_Email_Subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Check_Overall_Failed_Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.Env} | @{if(greater(activity('Check_Overall_Failed_Count').output.firstRow.COUNT,0),'FAILED','SUCCESS')} | CARESYNC MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check_Overall_Failed_Count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT COUNT (*) as COUNT\nFROM ctrl.audit_log \nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\nAND status != 'Success';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Prepare_Logic_Apps_Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare_Email_Body_Header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare_Email_Body_Footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare_Email_Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read_All_Tables_Status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n    \"subject\": \"@{variables('email_subject')}\",\n    \"email_recipients\": \"@{pipeline().globalParameters.Email_Receiptient}\",\n    \"body_header\": \"@{variables('body_header')}\",\n    \"body_footer\": \"@{variables('body_footer')}\",\n    \"status_table\": @{activity('Read_All_Tables_Status').output.value}\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Send_Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Prepare_Logic_Apps_Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.Logic_Apps_URL",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "f4c55e39-5553-446e-bb46-1eb2c8c08fe7"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			}
		},
		"annotations": []
	}
}