														"value": "@concat(\n    'SELECT * FROM public.',\n    activity('Read_Table_Details').output.firstRow.source_table_name,\n    if(\n        equals(activity('Read_Table_Details').output.firstRow.load_type, 'FULL'),\n        '',\n        concat(\n            ' WHERE ',\n            activity('Read_Table_Details').output.firstRow.watermark_column,\n            ' > ''',\n            variables('Watermark_Variable'),\n            ''''\n        )\n    )\n)",
