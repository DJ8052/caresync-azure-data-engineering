{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "devon-adf-lookup-demo"
		},
		"LS_ADLS_CareSync_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncadlsdev.dfs.core.windows.net/"
		},
		"LS_KeyVault_CareSync_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kvcaresyncdev.vault.azure.net/"
		},
		"LS_PostgreSQL_CareSync_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-cool-union-be705tdy-pooler.c-9.us-east-2.aws.neon.tech"
		},
		"LS_PostgreSQL_CareSync_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSQL_CareSync_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "devon-adf-lookup-demo_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_CareSync_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_CareSync_properties_typeProperties_url')]"
					},
					"LS_KeyVault_CareSync_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_CareSync_properties_typeProperties_baseUrl')]"
					},
					"LS_PostgreSQL_CareSync_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSQL_CareSync_properties_typeProperties_server')]"
					},
					"LS_PostgreSQL_CareSync_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSQL_CareSync_properties_typeProperties_database')]"
					},
					"LS_PostgreSQL_CareSync_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSQL_CareSync_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}